SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_CHANNEL_ID=C0123456789

# Optional: GitHub personal access token. Without one, the public API allows
# only 60 requests/hour per IP. With one, 5000/hour. Required for private repos.
GITHUB_TOKEN=

# Optional: comma-separated list of repos to watch. Accepts "owner/repo" or
# full github URLs (with or without .git). If empty, the hardcoded default
# list in index.js is used.
# REPOS=OpenHands/OpenHands,virattt/dexter,...

# Delay between checking each repo, in seconds. With N repos, one full cycle
# takes N * REPO_DELAY_SECONDS. Defaults to 20s.
REPO_DELAY_SECONDS=20
